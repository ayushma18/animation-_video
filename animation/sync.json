                  },
                  {
                      "id":  "tm",
                      "text":  "Ten ones make one ten!",
                      "startMs":  43367,
                      "endMs":  45591
                  },
                  {
                      "id":  "te",
                      "text":  "Ten ones equals one ten.",
                      "startMs":  45921,
                      "endMs":  48260
                  },
                  {
                      "id":  "tn",
                      "text":  "This is Tenny. Tenny is a ten.",
                      "startMs":  48531,
                      "endMs":  51855
                  },
                  {
                      "id":  "b0",
                      "text":  "Let\u0027s build a number.",
                      "startMs":  52185,
                      "endMs":  54024
                  },
                  {
                      "id":  "b1",
                      "text":  "Here are three tens.",
                      "startMs":  54234,
                      "endMs":  56213
                  },
                  {
                      "id":  "b2",
                      "text":  "And here are four ones.",
                      "startMs":  56423,
                      "endMs":  58552
                  },
                  {
                      "id":  "b3",
                      "text":  "Three tens and four ones make thirty-four.",
                      "startMs":  58762,
                      "endMs":  61881
                  },
                  {
                      "id":  "p1",
                      "text":  "In thirty-four, the three is in the tens place.",
                      "startMs":  62361,
                      "endMs":  66005
                  },
                  {
                      "id":  "p2",
                      "text":  "And the four is in the ones place.",
                      "startMs":  66215,
                      "endMs":  68704
                  },
                  {
                      "id":  "p3",
                      "text":  "Three tens is thirty.",
                      "startMs":  68914,
                      "endMs":  70913
                  },
                  {
                      "id":  "p4",
                      "text":  "And four ones is four.",
                      "startMs":  71123,
                      "endMs":  73227
                  },
                  {
                      "id":  "p5",
                      "text":  "Thirty plus four equals thirty-four.",
                      "startMs":  73438,
                      "endMs":  76316
                  },
                  {
                      "id":  "a0",
                      "text":  "Let\u0027s try another number.",
                      "startMs":  76736,
                      "endMs":  78851
                  },
                  {
                      "id":  "a1",
                      "text":  "Here are five tens.",
                      "startMs":  79061,
                      "endMs":  81115
                  },
                  {
                      "id":  "a2",
                      "text":  "And two ones.",
                      "startMs":  81325,
                      "endMs":  83029
                  },
                  {
                      "id":  "a3",
                      "text":  "That makes fifty-two.",
                      "startMs":  83239,
                      "endMs":  85268
                  },
                  {
                      "id":  "q1",
                      "text":  "Which number is greater? Thirty-four, or fifty-two?",
                      "startMs":  85688,
                      "endMs":  90517
                  },
                  {
                      "id":  "q2",
                      "text":  "Look at the tens first.",
                      "startMs":  93017,
                      "endMs":  95131
                  },
                  {
                      "id":  "q3",
                      "text":  "Five tens is more than three tens.",
                      "startMs":  95341,
                      "endMs":  98150
                  },
                  {
                      "id":  "q4",
                      "text":  "So fifty-two is greater than thirty-four.",
                      "startMs":  98360,
                      "endMs":  101510
                  },
                  {
                      "id":  "r1",
                      "text":  "A two-digit number is made of tens and ones.",
                      "startMs":  101930,
                      "endMs":  105238
                  },
                  {
                      "id":  "r2",
                      "text":  "Three tens and four ones make thirty-four.",
                      "startMs":  105448,
                      "endMs":  108567
                  },
                  {
                      "id":  "r3",
                      "text":  "Great job! See you next time!",
                      "startMs":  108837,
                      "endMs":  112337
                  }
              ]
}
